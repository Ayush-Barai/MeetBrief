# ---------------------------------------------------------------------------
# MeetBrief AI — environment variables
# Copy this file to .env.local for local development.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# MongoDB Atlas (required for persistence)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=meetbrief

# Signs the browser ownership cookie. Use 32+ random characters in production.
SESSION_SECRET=replace-with-a-long-random-string

# Public application URL (used in share links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Transcription — choose ONE provider
# TRANSCRIPTION_PROVIDER=deepgram | whisper
# ---------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=deepgram

# Deepgram (timestamps + speaker diarization). Recommended.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# OpenAI-compatible Whisper endpoint (timestamps, no diarization by default).
# Works with api.openai.com and self-hosted compatible servers.
TRANSCRIPTION_API_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Gemma — an OpenAI-compatible chat completions endpoint serving Gemma.
# Examples: Ollama (http://host:11434/v1), vLLM, LiteLLM, hosted inference.
# GEMMA_API_URL must point to the base URL or the full /chat/completions URL.
# ---------------------------------------------------------------------------
GEMMA_API_URL=http://localhost:11434/v1
GEMMA_API_KEY=
GEMMA_MODEL=gemma3:27b
GEMMA_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# ElevenLabs text-to-speech
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------------------------------------------------------------------------
# Application limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=60
