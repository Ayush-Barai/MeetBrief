# ---------------------------------------------------------------------------
# MeetBrief AI — environment variables
# Copy this file to .env.local for local development.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# MongoDB Atlas (required for persistence)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=meetbrief

# Signs the browser ownership cookie. Use 32+ random characters in production.
SESSION_SECRET=replace-with-a-long-random-string

# Public application URL (used in share links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Transcription — self-hosted open-source Whisper (OpenAI-compatible API)
#
# Run ScribeCrate / faster-whisper-server locally:
#   docker run -d --name whisper -p 9000:9000 \
#     -e WHISPER_MODEL=large-v3-turbo -e WHISPER_DIARIZATION=true \
#     -v whisper-data:/var/lib/whisper hwdsl2/whisper-server
# Then set TRANSCRIPTION_API_URL to its /v1 base URL. The API key is optional
# for a local server; set it when the server requires Bearer auth.
# ---------------------------------------------------------------------------
TRANSCRIPTION_API_URL=http://localhost:9000/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# Gemma — an OpenAI-compatible chat completions endpoint serving Gemma.
# Examples: Ollama (http://host:11434/v1), vLLM, LiteLLM, hosted inference.
# GEMMA_API_URL must point to the base URL or the full /chat/completions URL.
# ---------------------------------------------------------------------------
GEMMA_API_URL=http://localhost:11434/v1
GEMMA_API_KEY=
GEMMA_MODEL=gemma3:27b
GEMMA_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# ElevenLabs text-to-speech
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------------------------------------------------------------------------
# Application limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=60
